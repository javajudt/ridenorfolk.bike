---
import { shop } from '../data/site.js';
---
<div class="card shop-card">
  <p class="pill pill-gold">Local shop</p>
  <h3 class="mb-0">{shop.name}</h3>
  <p class="muted shop-line">Your spot for tune-ups, tires, chains, batteries, and cables. Ask for {shop.contact}, then let's ride.</p>
  <dl class="shop-details">
    <div><dt>Where</dt><dd>{shop.address}</dd></div>
    <div><dt>Call</dt><dd><a href={shop.phoneHref}>{shop.phone}</a></dd></div>
    <div><dt>Email</dt><dd><a href={`mailto:${shop.email}`}>{shop.email}</a></dd></div>
    <div><dt>Hours</dt><dd>{shop.hours}</dd></div>
  </dl>
</div>
<style>
  .shop-line { margin: .4rem 0 1rem; }
  .shop-details { margin: 0; display: grid; gap: .6rem; }
  .shop-details > div { display: grid; grid-template-columns: 4.5rem 1fr; gap: .5rem; align-items: baseline; }
  .shop-details dt { font-family: var(--font-display); font-weight: 700; color: var(--trail); text-transform: uppercase; font-size: .78rem; letter-spacing: .04em; }
  .shop-details dd { margin: 0; color: var(--text); }
</style>
