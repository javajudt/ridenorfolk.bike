---
import Logo from './Logo.astro';
import { site, nav, shop } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo variant="light" height={34} />
      <p class="footer-tag">{site.tagline}</p>
      <p class="footer-desc">The go-to source for group rides, the Cowboy Trail, and cycling in Norfolk, Nebraska. All paces. No drop. Always welcome.</p>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <ul>
        <li><a href="/">Home</a></li>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h4>Connect</h4>
      <ul>
        <li><a href={site.stravaClubUrl} target="_blank" rel="noopener">Strava club</a></li>
        <li><a href="/#newsletter">Weekly newsletter</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Local shop</h4>
      <ul>
        <li>{shop.name}</li>
        <li>{shop.address}</li>
        <li><a href={shop.phoneHref}>{shop.phone}</a></li>
        <li class="muted-light">{shop.hours}</li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}. Made in Norfolk, Nebraska.</p>
    <p class="disclaimer">
      Ride Norfolk is an unstructured group of individual cyclists who gather for group rides.
      By taking part, each rider is solely and individually responsible for their own health and safety.
    </p>
  </div>
</footer>
<style>
  .site-footer { background: var(--trail); color: #E7E2D6; padding: 3.5rem 0 2rem; margin-top: 0; }
  .footer-grid { display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 2fr 1fr 1fr 1.4fr; } }
  .footer-tag { font-family: var(--font-display); font-weight: 700; color: var(--gold); margin: .8rem 0 .4rem; font-size: 1.15rem; }
  .footer-desc { color: #CFD8CC; font-size: .95rem; max-width: 34ch; }
  .footer-col h4 { color: #fff; font-size: 1.05rem; margin-bottom: .8rem; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: .5rem; font-size: .95rem; color: #D8E0D4; }
  .footer-col a { color: #E7E2D6; text-decoration: none; }
  .footer-col a:hover { color: var(--gold); text-decoration: underline; }
  .muted-light { color: #A9B6A6 !important; font-size: .85rem; }
  .footer-bottom {
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.15);
    display: flex; flex-direction: column; gap: .6rem;
  }
  .footer-bottom p { margin: 0; font-size: .85rem; color: #B9C4B5; }
  .disclaimer { max-width: 70ch; }
</style>
