---
import Base from '../layouts/Base.astro';
import SafetyBanner from '../components/SafetyBanner.astro';
import RideCard from '../components/RideCard.astro';
import StravaCTA from '../components/StravaCTA.astro';
import ShopCard from '../components/ShopCard.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { rides } from '../data/rides.js';
import { upcomingEvents, formatDate } from '../data/events.js';
const chipotle = rides.find((r) => r.slug === 'chipotle');
const next = upcomingEvents().slice(0, 4);
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-scene" aria-hidden="true">
      <svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FBF6EC"/>
            <stop offset="1" stop-color="#FDEBD3"/>
          </linearGradient>
        </defs>
        <rect width="1440" height="420" fill="url(#sky)"/>
        <circle cx="1080" cy="150" r="70" fill="#F4A93C" opacity="0.9"/>
        <path d="M0 300 C 300 250, 500 320, 760 285 C 1000 255, 1220 300, 1440 270 L1440 420 L0 420 Z" fill="#2C7A54" opacity="0.28"/>
        <path d="M0 340 C 280 300, 560 360, 820 330 C 1080 305, 1260 345, 1440 320 L1440 420 L0 420 Z" fill="#1F5C3D" opacity="0.9"/>
        <path d="M0 372 H1440" stroke="#E8562D" stroke-width="4" stroke-dasharray="26 20" opacity="0.85"/>
      </svg>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow">Norfolk, Nebraska · est. on Tuesdays</p>
      <h1 class="hero-title">Where Norfolk Rides.</h1>
      <p class="hero-lead">
        We're a friendly crew of cyclists who roll all summer long — weekly loops of town, full-moon
        rides on the Cowboy Trail, and the occasional weekend adventure. <strong>All paces. No drop. Always welcome.</strong>
      </p>
      <div class="hero-actions">
        <a href="#newsletter" class="btn btn-primary">Join the Newsletter</a>
        <a href="/rides/" class="btn btn-outline">See the Rides</a>
      </div>
    </div>
  </section>

  <SafetyBanner />

  <!-- Featured: The Chipotle Ride -->
  <section class="section chipotle-feature">
    <div class="container chip-grid">
      <div class="chip-copy">
        <p class="pill pill-sunset">Our signature ride</p>
        <h2>The Chipotle Ride</h2>
        <p class="lead">{chipotle.summary}</p>
        <p class="chip-meta">
          <strong>Every Tuesday</strong> in season · <strong>{chipotle.distance}</strong> ·
          rolls from {chipotle.start}.
        </p>
        <a href="/rides/#chipotle" class="btn btn-primary">Full ride details</a>
      </div>
      <div class="chip-groups">
        {chipotle.groups.map((g) => (
          <div class="chip-group card">
            <div class="chip-time">{g.time}</div>
            <div>
              <div class="chip-label">{g.label}</div>
              <div class="chip-pace">{g.pace}</div>
              <p class="chip-note muted mb-0">{g.note}</p>
            </div>
          </div>
        ))}
        <p class="chip-after muted">🍔 {chipotle.after}</p>
      </div>
    </div>
  </section>

  <!-- All rides -->
  <section class="section section-sand">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ways to ride</p>
        <h2>Find your ride</h2>
        <p class="lead">Three regular flavors of riding, plus whatever adventures pop up. Everyone's welcome at every one.</p>
      </div>
      <div class="grid grid-3 rides-grid">
        {rides.map((ride) => <RideCard ride={ride} />)}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section-trail section-tight">
    <div class="container stats-row">
      <div class="stat"><div class="stat-num" style="color:var(--gold)">32</div><div class="stat-label">Record Tuesday turnout</div></div>
      <div class="stat"><div class="stat-num" style="color:var(--gold)">14</div><div class="stat-label">Miles, the Chipotle loop</div></div>
      <div class="stat"><div class="stat-num" style="color:var(--gold)">2</div><div class="stat-label">Paces, so all are welcome</div></div>
      <div class="stat"><div class="stat-num" style="color:var(--gold)">🌕</div><div class="stat-label">Monthly full-moon ride</div></div>
    </div>
  </section>

  <!-- Strava + Shop -->
  <section class="section">
    <div class="container grid grid-2">
      <StravaCTA />
      <ShopCard />
    </div>
  </section>

  <!-- Upcoming events preview -->
  <section class="section section-sand">
    <div class="container">
      <div class="section-head with-link">
        <div>
          <p class="eyebrow">On the calendar</p>
          <h2>Coming up</h2>
        </div>
        <a href="/events/" class="btn btn-outline">Full calendar</a>
      </div>
      <ul class="mini-events">
        {next.map((e) => (
          <li class="mini-event card">
            <span class={`mini-date pill pill-${e.color}`}>{formatDate(e.date)}</span>
            <div class="mini-body">
              <strong>{e.title}</strong>
              <span class="muted">{e.time} · {e.location}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <NewsletterSignup />
</Base>

<style>
  .hero { position: relative; overflow: hidden; }
  .hero-scene { position: absolute; inset: 0; z-index: 0; }
  .hero-scene svg { width: 100%; height: 100%; }
  .hero-inner { position: relative; z-index: 1; padding: 4.5rem 1.25rem 6rem; max-width: 780px; }
  .hero-title { font-size: clamp(2.6rem, 7vw, 4.6rem); margin-bottom: .4rem; }
  .hero-lead { font-size: 1.25rem; color: #40423f; max-width: 40ch; }
  .hero-actions { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.8rem; }

  .section-head { max-width: 60ch; margin-bottom: 2.2rem; }
  .section-head.with-link { max-width: none; display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

  /* Chipotle feature */
  .chip-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 860px) { .chip-grid { grid-template-columns: 1.1fr 1fr; } }
  .chip-meta { font-size: 1.05rem; }
  .chip-group { display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem; }
  .chip-time { font-family: var(--font-display); font-weight: 800; font-size: 1.7rem; color: var(--sunset); flex: none; width: 5.2rem; }
  .chip-label { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
  .chip-pace { color: var(--sky-dark); font-weight: 600; font-size: .95rem; }
  .chip-note { font-size: .9rem; margin-top: .2rem; }
  .chip-after { font-size: .95rem; margin-top: .4rem; }

  .stats-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; text-align: center; }
  @media (min-width: 720px) { .stats-row { grid-template-columns: repeat(4, 1fr); } }
  .stat-label { color: #D3DBCE; font-size: .92rem; margin-top: .3rem; }

  .mini-events { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .mini-event { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.2rem; }
  .mini-date { flex: none; }
  .mini-body { display: flex; flex-direction: column; }
  .mini-body span { font-size: .9rem; }
</style>
