---
import Base from '../layouts/Base.astro';
import ShopCard from '../components/ShopCard.astro';
import StravaCTA from '../components/StravaCTA.astro';
import { site } from '../data/site.js';
---
<Base title="Contact" description="Get in touch with Ride Norfolk — join a ride, ask a question, or add an event.">
  <section class="page-hero">
    <div class="container-narrow">
      <p class="eyebrow">Say hello</p>
      <h1>Get in touch</h1>
      <p class="lead">Questions about a ride, want to be added to the newsletter, or have an event to share? We'd love to hear from you.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2">
      <div class="card">
        <h2 class="mt-0">Send us a note</h2>
        <p class="muted">This form opens your email app. Prefer Strava? Find the club and message us there.</p>
        <form class="contact-form" id="contact-form">
          <label>Name
            <input type="text" name="name" required />
          </label>
          <label>Email
            <input type="email" name="email" required />
          </label>
          <label>What's up?
            <textarea name="message" rows="5" required placeholder="Ask about a ride, request the newsletter, share an event…"></textarea>
          </label>
          <button type="submit" class="btn btn-primary">Open email to send</button>
        </form>
      </div>

      <div class="stack">
        <div class="card">
          <h3 class="mt-0">Direct</h3>
          <p class="mb-0">Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p class="muted">The newsletter goes out about once a week in season. Reply to any issue to reach an organizer.</p>
        </div>
        <StravaCTA />
        <ShopCard />
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = encodeURIComponent(data.get('name') || '');
    const msg = encodeURIComponent(data.get('message') || '');
    const from = data.get('email') || '';
    const subject = encodeURIComponent(`Ride Norfolk — message from ${data.get('name') || 'a rider'}`);
    const body = encodeURIComponent(`${data.get('message')}\n\n— ${data.get('name')} (${from})`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>

<style>
  .page-hero { padding: 3.5rem 0 1rem; }
  .contact-form { display: grid; gap: 1rem; margin-top: 1rem; }
  .contact-form label { display: grid; gap: .35rem; font-family: var(--font-display); font-weight: 700; font-size: .95rem; }
  .contact-form input, .contact-form textarea {
    font-family: var(--font-body); font-weight: 400; font-size: 1rem;
    padding: .7rem .85rem; border: 1px solid var(--border); border-radius: var(--radius-sm);
    background: var(--cream); color: var(--asphalt);
  }
  .contact-form input:focus, .contact-form textarea:focus { outline: none; border-color: var(--sky); }
</style>
