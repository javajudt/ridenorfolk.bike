---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section text-center">
    <div class="container-narrow">
      <p class="eyebrow">Wrong turn</p>
      <h1>That page took a gravel detour</h1>
      <p class="lead">We couldn't find what you were looking for. Let's get you back on route.</p>
      <p><a href="/" class="btn btn-primary">Back to home</a> &nbsp; <a href="/rides/" class="btn btn-outline">See the rides</a></p>
    </div>
  </section>
</Base>
